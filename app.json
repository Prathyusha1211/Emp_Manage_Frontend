{
  "expo": {
    "name": "Mark Mate",
    "slug": "emp-manage-frontend",
    "scheme": "empmanage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F7FBFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7FBFF"
      },
      "package": "com.employee.management.markmate"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ed077a8-89ff-404c-bb03-8e4fbe94765b"
      }
    }
  }
}
